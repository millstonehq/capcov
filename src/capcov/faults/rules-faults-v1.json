 "description": "Fault-harness invariants over one run. Each invariant is a derived violation relation; violated(run, name) projects it; violated_closed(run, name) is derived only when every completeness relation in that invariant's `requires` list is present; holds(run, name) is the claim, derived from violated_closed and the absence of violated. Intents are compared with stores by (store, key, value digest), so two intents of one run must not share all three.",
 "id": "rules-faults-v1",
 "invariants": [
  {
   "name": "effect_applied_twice",
   "requires": [
    "intents_closed",
    "applied_closed"
   ]
  },
  {
   "name": "orphan_change",
   "requires": [
    "ops_closed",
    "changes_closed",
    "intents_closed"
   ]
  },
  {
